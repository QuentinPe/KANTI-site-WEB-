# Supabase — copier dans .env.local et renseigner les valeurs réelles
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Email de bootstrap admin (accès admin avant population de la table admin_users)
VITE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# CORS — domaine autorisé pour les API Vercel Edge
ALLOWED_ORIGIN=https://kanti.fr

# Telegram Bot — notifications leads
TELEGRAM_BOT_TOKEN=votre_token_botfather_ici
TELEGRAM_CHAT_ID=votre_chat_id_ici

# Groq — génération d'articles IA
GROQ_API_KEY=votre_clé_groq_ici

# Resend — emails de confirmation aux prospects (https://resend.com)
# Si absent, les confirmations email sont ignorées silencieusement
RESEND_API_KEY=re_xxxx

# Calendly — lien de prise de rendez-vous inclus dans l'email de confirmation (facultatif)
CALENDLY_URL=https://calendly.com/votre-lien

# Vercel Analytics — active les métriques de trafic dans /admin/analytics
# Obtenir sur : vercel.com → Settings → Tokens
# Ces 3 variables sont SERVEUR UNIQUEMENT — ne jamais préfixer VITE_
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# PostHog — tracking d'événements (CTA, formulaires, quiz, simulateurs)
# Obtenir sur : posthog.com → Project Settings → Project API key
VITE_POSTHOG_KEY=phc_xxxx
VITE_POSTHOG_HOST=https://eu.posthog.com

# PostHog API personnelle — pour /admin/analytics (requêtes côté serveur uniquement)
# Obtenir sur : posthog.com → Settings → Personal API Keys
POSTHOG_PERSONAL_API_KEY=phx_xxxx
POSTHOG_PROJECT_ID=
